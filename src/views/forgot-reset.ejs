<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap narrow">
  <h1>設定新密碼</h1>
  <p class="hint">驗證碼已發給 <strong><%= mobile %></strong>，10 分鐘內有效。</p>
  <% if (devCode) { %>
    <aside class="dev-code">
      <p>示範站的開發模式驗證碼。沒有送出簡訊。</p>
      <p id="dev-code"><%= devCode %></p>
    </aside>
  <% } %>
  <section class="card auth-card">
    <form method="post" action="/forgot/reset" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="reset_code">6 位數驗證碼</label>
        <input id="reset_code" name="code" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" required>
      </div>
      <div class="field">
        <label for="reset_password">新密碼</label>
        <input id="reset_password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required>
      </div>
      <div class="field">
        <label for="reset_password_confirm">再輸入一次</label>
        <input id="reset_password_confirm" name="password_confirm" type="password" autocomplete="new-password" minlength="8" maxlength="64" required>
      </div>
      <button class="primary-action" type="submit">更新密碼</button>
    </form>
    <div class="auth-foot">
      <span class="auth-foot-right"><a href="/forgot">換成別的手機號碼</a></span>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
