<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap">
  <% if (announcement) { %>
    <aside class="announcement" data-announcement="<%= announcement.id %>" aria-label="站內公告">
      <p>
        <% if (announcement.title) { %><strong><%= announcement.title %></strong> <% } %><%= announcement.body %>
      </p>
      <% if (user) { %>
        <form method="post" action="/announcements/<%= announcement.id %>/dismiss">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="secondary" type="submit">知道了</button>
        </form>
      <% } %>
    </aside>
  <% } %>
  <section class="hero">
    <h1>今天可以接的互助</h1>
    <p>食物、交通，或其他需要。你可以寫「我可以提供」，也可以寫「我需要」。標一個功德金額，最後以雙方認定的較低者結算。</p>
    <form class="filter" method="get" action="/">
      <div class="field">
        <label for="filter-city">縣市</label>
        <select id="filter-city" name="city">
          <option value="all" <%= filterCity === 'all' ? 'selected' : '' %>>全部</option>
          <% cities.forEach(function (city) { %>
            <option value="<%= city %>" <%= filterCity === city ? 'selected' : '' %>><%= city %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="filter-category">種類</label>
        <select id="filter-category" name="category">
          <option value="">全部</option>
          <option value="food" <%= filterCategory === 'food' ? 'selected' : '' %>>食物</option>
          <option value="transport" <%= filterCategory === 'transport' ? 'selected' : '' %>>交通</option>
          <option value="other" <%= filterCategory === 'other' ? 'selected' : '' %>>其他</option>
        </select>
      </div>
      <button type="submit">篩選</button>
      <label class="check filter-public">
        <input type="checkbox" name="public" value="1" <%= filterPublic ? 'checked' : '' %>>
        只看公共場所見面
      </label>
    </form>
    <% if (!user) { %>
      <p><a class="button" href="/login">用手機號碼加入</a></p>
    <% } else if (!user.blocked) { %>
      <p><a class="button" href="/posts/new">發布一則</a></p>
    <% } %>
  </section>

  <% if (!posts.length) { %>
    <p class="empty">廣場還沒有招募中的貼文。</p>
  <% } %>

  <div class="post-list">
    <% posts.forEach(function (post) { %>
      <article class="card">
        <div class="card-top">
        <p class="meta">
          <span class="tag tag-<%= post.kind %>"><%= kindLabel(post.kind) %></span>
          <span class="tag"><%= categoryLabel(post.category) %></span>
          <% if (post.city) { %><span class="tag"><%= post.city %><% if (post.district) { %> <%= post.district %><% } %></span><% } %>
          <% if (post.meeting_mode) { %><span class="tag" data-meeting-mode="<%= post.meeting_mode %>"><%= post.meeting_mode %></span><% } %>
          <span>標示 <%= formatMerit(post.amount) %> 功德</span>
        </p>
        <% if (user && !user.blocked) { %>
          <%- include('partials/bookmark', { postId: post.id, saved: !!post.bookmarked, returnTo: '/' }) %>
        <% } %>
        </div>
        <h2><a href="/posts/<%= post.id %>"><%= post.title || (kindLabel(post.kind) + ' · ' + categoryLabel(post.category)) %></a></h2>
        <p class="excerpt"><%= post.description %></p>
        <p class="meta">
          <a href="/users/<%= post.author_id %>"><%= post.author_name %></a><%- include('partials/mini-badge', { badge: post.author_badge }) %><%- include('partials/last-seen', { label: post.author_seen }) %>
          · <%= roleLabel(post.author_role) %>
          <% if (post.author_count) { %>
            · <span class="stars"><%= starGlyph(post.author_avg) %></span> <%= post.author_avg %>
          <% } else { %>
            · 尚無星等
          <% } %>
          · 幫過 <%= post.author_helped %> 次
          <% if (post.author_availability) { %> · 今日空檔 <%= post.author_availability %><% } %>
        </p>
      </article>
    <% }) %>
  </div>
</main>
<%- include('partials/footer') %>
