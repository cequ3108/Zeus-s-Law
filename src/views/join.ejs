<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap narrow">
  <h1>建立帳號</h1>
  <% if (devSms) { %>
    <p class="hint">只會成為一般使用者。功德與額度都是 100。</p>
    <section class="card auth-card">
      <form method="post" action="/join" autocomplete="on">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field">
          <label for="join_mobile">手機號碼</label>
          <input id="join_mobile" name="mobile" type="tel" inputmode="numeric" autocomplete="tel" placeholder="0912345678" required>
        </div>
        <div class="field">
          <label for="join_name">怎麼稱呼你</label>
          <input id="join_name" name="display_name" maxlength="20" autocomplete="nickname" required>
        </div>
        <div class="field">
          <label for="join_password">密碼</label>
          <input id="join_password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required>
        </div>
        <div class="field">
          <label for="join_password_confirm">再輸入一次密碼</label>
          <input id="join_password_confirm" name="password_confirm" type="password" autocomplete="new-password" minlength="8" maxlength="64" required>
        </div>
        <button class="primary-action" type="submit">建立帳號</button>
      </form>
      <p class="hint">8 到 64 個字。密碼只存雜湊。</p>
      <div class="auth-foot">
        <span class="auth-foot-right"><a href="/login">返回登入</a></span>
      </div>
    </section>
  <% } else { %>
    <section class="card auth-card">
      <p>已接上簡訊。請用驗證碼確認手機後建立帳號。</p>
      <p><a class="button" href="/login/code">用驗證碼建立</a></p>
      <div class="auth-foot">
        <span class="auth-foot-right"><a href="/login">返回登入</a></span>
      </div>
    </section>
  <% } %>
</main>
<%- include('partials/footer') %>
