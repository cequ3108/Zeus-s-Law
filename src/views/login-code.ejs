<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap narrow">
  <h1>用驗證碼登入</h1>
  <p class="hint"><%= devSms ? '示範站會把驗證碼顯示在下一頁。' : '驗證碼會發到這個手機。' %></p>
  <section class="card auth-card">
    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="code_mobile">手機號碼</label>
        <input id="code_mobile" name="mobile" type="tel" inputmode="numeric" autocomplete="username" placeholder="0912345678" value="<%= rememberedMobile %>" required>
      </div>
      <button class="primary-action" type="submit">取得驗證碼</button>
    </form>
    <div class="auth-foot">
      <span class="auth-foot-right"><a href="/login">改用密碼登入</a></span>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
