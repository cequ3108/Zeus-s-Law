<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap">
  <h1><%= profile.user.display_name %></h1>
  <p class="meta">
    <%= roleLabel(profile.user.role) %>
    · 加入於 <%= formatTaipei(profile.user.created_at) %>
    <% if (profile.user.city) { %> · <%= profile.user.city %><% if (profile.user.district) { %> <%= profile.user.district %><% } %><% } %>
    <% if (profile.user.blocked) { %> · 此帳號已被封鎖，不能發布或接下<% } %>
  </p>
  <% if (profile.user.availability) { %>
    <p>今日空檔：<%= profile.user.availability %></p>
  <% } %>
  <% if (canHide) { %>
    <form class="hide-form" method="post" action="/users/<%= profile.user.id %>/hide">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="secondary" type="submit">不想再遇到這個人</button>
    </form>
  <% } %>
  <% if (own) { %>
    <section class="balances" aria-label="我的餘額">
      <article class="card balance">
        <p>功德額度</p>
        <strong data-quota="<%= own.quota %>"><%= formatMerit(own.quota) %></strong>
      </article>
      <article class="card balance">
        <p>功德</p>
        <strong data-merit="<%= own.merit %>"><%= formatMerit(own.merit) %></strong>
      </article>
    </section>
  <% } %>
  <section class="card" data-helped="<%= profile.reputation.helped %>" data-helped-by="<%= profile.reputation.helpedBy %>" data-rating-count="<%= profile.ratingCount %>" data-rating-avg="<%= profile.ratingAvg == null ? '' : profile.ratingAvg %>">
    <h2>信譽</h2>
    <p>幫過別人 <%= profile.reputation.helped %> 次 · 被幫過 <%= profile.reputation.helpedBy %> 次</p>
    <% if (profile.reputation.badges.length) { %>
      <p>
        <% profile.reputation.badges.forEach(function (badge) { %>
          <span class="tag"><%= badge %></span>
        <% }) %>
      </p>
    <% } else { %>
      <p class="hint">完成互助之後，這裡會出現徽章。徽章不另發功德。</p>
    <% } %>
  </section>
  <section class="card" data-completed="<%= profile.milestones.completed %>" data-fives="<%= profile.milestones.fives %>" aria-label="互助里程碑">
    <h2>互助里程碑</h2>
    <% profile.milestones.badges.forEach(function (badge) { %>
      <p class="milestone<%= badge.earned ? ' is-earned' : ' is-locked' %>" data-milestone="<%= badge.id %>" data-earned="<%= badge.earned ? '1' : '0' %>">
        <span class="tag"><%= badge.label %></span>
        <%= badge.criterion %>
        <% if (badge.earned) { %> · 已達成<% } else { %> · 還差 <%= badge.remaining %><%= badge.unit %><% } %>
      </p>
    <% }) %>
  </section>
  <section class="card" data-rating-count="<%= profile.ratingCount %>" data-rating-avg="<%= profile.ratingAvg == null ? '' : profile.ratingAvg %>">
    <h2>星等</h2>
    <% if (profile.ratingCount) { %>
      <p class="stars big-stars"><%= starGlyph(profile.ratingAvg) %></p>
      <p>平均 <%= profile.ratingAvg %> / 5，共 <%= profile.ratingCount %> 則。</p>
      <% if (profile.tags.length) { %>
        <p class="tag-counts" aria-label="評價標籤">
          <% profile.tags.forEach(function (item) { %>
            <span class="tag"><%= item.tag %> ×<%= item.count %></span>
          <% }) %>
        </p>
      <% } %>
    <% } else { %>
      <p>尚無星等。</p>
    <% } %>
  </section>
  <% if (profile.ratings.length) { %>
    <h2>收到的星等</h2>
    <% profile.ratings.forEach(function (rating) { %>
      <article class="card">
        <p class="stars"><%= starGlyph(rating.stars) %> <%= rating.stars %> 星</p>
        <p class="meta">
          <a href="/users/<%= rating.rater_id %>"><%= rating.rater_name %></a>
          · <%= formatTaipei(rating.created_at) %>
        </p>
      </article>
    <% }) %>
  <% } %>
  <p><a href="/rules">規則與常見問題</a></p>
</main>
<%- include('partials/footer') %>
