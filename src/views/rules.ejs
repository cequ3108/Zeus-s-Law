<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap prose rules-page">
  <h1><%= rulesPage.title %></h1>
  <p><%= rulesPage.intro %></p>
  <% rulesPage.sections.forEach(function (section) { %>
    <section>
      <h2><%= section.heading %></h2>
      <% if (section.paragraphs) { %>
        <% section.paragraphs.forEach(function (paragraph) { %>
          <p><%= paragraph %></p>
        <% }) %>
      <% } %>
      <% if (section.items) { %>
        <ul>
          <% section.items.forEach(function (item) { %>
            <li><%= item %></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>
  <section aria-label="如何加到主畫面">
    <h2>如何加到主畫面</h2>
    <ul>
      <li>iPhone：用 Safari 打開本站，按分享，再點「加入主畫面」。</li>
      <li>Android：用 Chrome 打開本站，按選單，再點「安裝應用程式」。</li>
    </ul>
    <p data-install-prompt hidden>
      <button type="button" data-install-button>安裝到主畫面</button>
    </p>
  </section>
</main>
<script src="<%= asset('/install.js') %>"></script>
<%- include('partials/footer') %>
