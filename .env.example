PORT=3000
SESSION_SECRET=please-change-me

# 資料庫目錄。主機有持久磁碟時，指到那顆磁碟。DB_PATH 若有設定會蓋過這裡。
DATA_DIR=./data
# DB_PATH=./data/zeus.db

# 第一次啟動時，若這個手機還沒有帳號，會建立創辦人（功德與額度都是 100,000,000）。
# 之後再啟動只會更新密碼雜湊，不會把餘額補回去。密碼不會寫進版本庫，資料庫也只存 scrypt 雜湊。
# FOUNDER_PHONE=09xxxxxxxx
# FOUNDER_PASSWORD=

# 不設定 SMS_PROVIDER，或設為 dev：不呼叫簡訊商。可以用手機號碼加密碼註冊，驗證碼也會顯示在畫面上。
# SMS_PROVIDER=dev

# 改接 EVERY8D 時才填下面幾行。不要把真的帳號密碼commit 進版本庫。
# SMS_PROVIDER=every8d
# EVERY8D_UID=
# EVERY8D_PWD=
# EVERY8D_API_URL=https://api.e8d.tw/API21/HTTP/SendSMS.ashx
